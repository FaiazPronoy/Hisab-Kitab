# Copy to .env and adjust. Every service in docker-compose.yml reads this file.

# API key sent by clients in the X-API-Key header. Change it outside local use.
API_KEY=local-dev-key
CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel
POSTGRES_DB=docintel
DATABASE_URL=postgresql+psycopg://docintel:docintel@postgres:5432/docintel
REDIS_URL=redis://redis:6379/0

STORAGE_DIR=/data/storage

# LLM provider: gemini or mock. mock needs no key and returns recorded answers.
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash-lite
LLM_VISION_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# stop LLM calls once this much has been spent in one process (USD)
LLM_BUDGET_USD=2.00
LLM_MAX_CONCURRENCY=4
LLM_RATE_PER_MINUTE=60

# limits
MAX_UPLOAD_MB=60
MAX_FILES_PER_REQUEST=50
MAX_PAGES=1500
MAX_SHEET_ROWS=200000

# web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_KEY=local-dev-key
