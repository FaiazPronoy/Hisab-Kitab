# Copy to .env and adjust. Every service in docker-compose.yml reads this file.

# API key sent by clients in the X-API-Key header. Change it outside local use.
API_KEY=local-dev-key
CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel
POSTGRES_DB=docintel
DATABASE_URL=postgresql+psycopg://docintel:docintel@postgres:5432/docintel
REDIS_URL=redis://redis:6379/0

STORAGE_DIR=/data/storage

# LLM provider: gemini or mock. mock needs no key and returns recorded answers.
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.5-flash-lite
LLM_VISION_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
# stop LLM calls once this much has been spent in one process (USD)
LLM_BUDGET_USD=2.00
LLM_MAX_CONCURRENCY=4
LLM_RATE_PER_MINUTE=15

# reviewers sign in; AUTH_SECRET signs their sessions. Use a long random value outside local use.
AUTH_SECRET=change-me-local-dev-secret
REQUIRE_LOGIN=true
# invoices at or above this total need an approver
APPROVAL_LIMIT=10000
SUPPLIER_MEMORY=true
# the paying company in pain.001 payment files
PAYER_NAME=Demo Trading Ltd
PAYER_IBAN=GB33BUKB20201555555555
PAYER_BIC=BUKBGB22

# worker processes; use 1 when Docker has less than about 4 GB of memory
WORKER_CONCURRENCY=2

# limits
MAX_UPLOAD_MB=60
MAX_FILES_PER_REQUEST=50
MAX_PAGES=1500
MAX_SHEET_ROWS=200000

# web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_KEY=local-dev-key
